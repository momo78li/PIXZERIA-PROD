Options -Indexes

# ── HTTPS erzwingen ────────────────────────────────────────────────────────────
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# ── pixzeria.de → pixzeria.com weiterleiten (301 Permanent) ───────────────────
RewriteCond %{HTTP_HOST} ^(www\.)?pixzeria\.de$ [NC]
RewriteRule ^(.*)$ https://pixzeria.com/$1 [R=301,L]

# ── React SPA: alle Routen auf index.html (Client-side Routing) ───────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /index.html [L]
